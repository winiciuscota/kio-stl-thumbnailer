#!/usr/bin/env python3
"""Software-rendered STL thumbnailer (freedesktop thumbnailer: stl-thumbnailer SIZE IN OUT).

Replaces stl-thumb, which renders blank images under Wayland/Mesa here.
Needs only numpy + Pillow; no GL.
"""
import sys

import numpy as np
from PIL import Image, ImageDraw

COLOR = np.array([38, 166, 154], dtype=float)  # teal, like the 3MF previews


def load_stl(path):
    data = open(path, "rb").read()
    if len(data) >= 84:
        n = int(np.frombuffer(data, "<u4", 1, 80)[0])
        if 84 + 50 * n == len(data):
            rec = np.frombuffer(data, np.dtype([("n", "<f4", 3), ("v", "<f4", (3, 3)), ("a", "<u2")]), n, 84)
            return rec["v"].astype(float)
    verts = []
    for line in data.decode("ascii", "ignore").splitlines():
        parts = line.split()
        if len(parts) == 4 and parts[0] == "vertex":
            verts.append([float(x) for x in parts[1:]])
    return np.array(verts, dtype=float).reshape(-1, 3, 3)


def decimate(tris, grid, limit=60000):
    """Vertex-cluster big meshes onto a coarse grid so rendering stays fast."""
    if len(tris) <= limit:
        return tris
    v = tris.reshape(-1, 3)
    lo, hi = v.min(0), v.max(0)
    cell = max((hi - lo).max(), 1e-9) / grid
    q = np.floor((v - lo) / cell).astype(np.int64).reshape(-1, 3, 3)
    keep = (q[:, 0] != q[:, 1]).any(1) & (q[:, 1] != q[:, 2]).any(1) & (q[:, 0] != q[:, 2]).any(1)
    q = q[keep]
    key = (q[:, :, 0] * (grid + 1) + q[:, :, 1]) * (grid + 1) + q[:, :, 2]
    key.sort(axis=1)
    _, idx = np.unique(key, axis=0, return_index=True)
    return (q[idx] + 0.5) * cell + lo


def render(tris, size):
    tris = decimate(tris, int(size * 0.8))
    ss = 3
    px = size * ss
    # Z-up model: yaw then tilt toward the camera
    yaw, tilt = np.radians(-35), np.radians(-60)
    cy, sy, ct, st = np.cos(yaw), np.sin(yaw), np.cos(tilt), np.sin(tilt)
    rz = np.array([[cy, -sy, 0], [sy, cy, 0], [0, 0, 1]])
    rx = np.array([[1, 0, 0], [0, ct, -st], [0, st, ct]])
    t = (tris.reshape(-1, 3) - tris.reshape(-1, 3).mean(0)) @ (rx @ rz).T
    t = t.reshape(-1, 3, 3)

    n = np.cross(t[:, 1] - t[:, 0], t[:, 2] - t[:, 0])
    ln = np.linalg.norm(n, axis=1)
    ok = ln > 0
    t, n, ln = t[ok], n[ok], ln[ok]
    n /= ln[:, None]
    n[n[:, 2] < 0] *= -1  # two-sided shading
    light = np.array([-0.4, 0.5, 0.75])
    light /= np.linalg.norm(light)
    shade = 0.3 + 0.7 * np.clip(n @ light, 0, 1)

    xy = t[:, :, :2]
    lo, hi = xy.reshape(-1, 2).min(0), xy.reshape(-1, 2).max(0)
    scale = 0.9 * px / max((hi - lo).max(), 1e-9)
    c = (lo + hi) / 2
    pts = (xy - c) * scale
    pts[:, :, 0] += px / 2
    pts[:, :, 1] = px / 2 - pts[:, :, 1]

    order = np.argsort(t[:, :, 2].mean(1))  # far (low z) first
    img = Image.new("RGBA", (px, px), (0, 0, 0, 0))
    d = ImageDraw.Draw(img)
    cols = np.clip(COLOR[None] * shade[:, None], 0, 255).astype(int)
    for i in order:
        p = pts[i]
        col = tuple(cols[i])
        d.polygon([tuple(p[0]), tuple(p[1]), tuple(p[2])], fill=col, outline=col)
    return img.resize((size, size), Image.LANCZOS)


def main():
    size, src, dst = int(sys.argv[1]), sys.argv[2], sys.argv[3]
    tris = load_stl(src)
    if len(tris) == 0:
        sys.exit(1)
    render(tris, size).save(dst, "PNG")


if __name__ == "__main__":
    main()
